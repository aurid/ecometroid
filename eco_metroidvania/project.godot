"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,window_id:0,alt_pressed:false,shift_pressed:false,ctrl_pressed:false,meta_pressed:false,pressed:false,keycode:0,physical_keycode:65,echo:false,script":null)
]
}
