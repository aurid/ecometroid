<?xml version="1.0" encoding="UTF-8"?>
<resource_file major="4" minor="2">
  <node name="Main" type="Node2D">
    <property name="script" type="Script" resource_path="res://scripts/main.gd"/>

    <!-- Player Node -->
    <node name="Player" type="CharacterBody2D">
      <property name="position" type="Vector2">400, 300</property>
      <property name="collision_layer" value="1"/>
      <property name="collision_mask" value="6"/>
      <property name="script" type="Script" resource_path="res://scripts/player/player.gd"/>

      <node name="Sprite2D" type="Sprite2D">
        <property name="modulate" type="Color">0, 1, 0, 1</property>
      </node>

      <node name="CollisionShape2D" type="CollisionShape2D">
        <property name="shape" type="RectangleShape2D">
          <resource local_to_scene="false">
            <property name="size" type="Vector2">32, 48</property>
          </resource>
        </property>
      </node>

      <node name="Camera2D" type="Camera2D">
        <property name="current" type="bool">true</property>
      </node>
    </node>

    <!-- Ecosystem Manager -->
    <node name="EcosystemManager" type="Node">
      <property name="script" type="Script" resource_path="res://scripts/systems/ecosystem_manager.gd"/>
    </node>

    <!-- Weather System -->
    <node name="WeatherSystem" type="Node2D">
      <property name="script" type="Script" resource_path="res://scripts/systems/weather_system.gd"/>
    </node>

    <!-- UI Layer -->
    <node name="UI" type="CanvasLayer">
      <property name="script" type="Script" resource_path="res://scripts/ui/game_ui.gd"/>

      <node name="VBoxContainer" type="VBoxContainer">
        <property name="offset_left" type="float">20</property>
        <property name="offset_top" type="float">20</property>
        <property name="offset_right" type="float">220</property>
        <property name="offset_bottom" type="float">150</property>

        <node name="EnergyLabel" type="Label">
          <property name="text" type="String">Energy: 100/100</property>
        </node>

        <node name="PopulationLabel" type="Label">
          <property name="text" type="String">Creatures: 0</property>
        </node>

        <node name="WeatherLabel" type="Label">
          <property name="text" type="String">Weather: Clear</property>
        </node>

        <node name="EcosystemLabel" type="Label">
          <property name="text" type="String">Ecosystem: Balanced</property>
        </node>
      </node>

      <node name="MessageLabel" type="Label">
        <property name="offset_left" type="float">760</property>
        <property name="offset_top" type="float">500</property>
        <property name="offset_right" type="float">1160</property>
        <property name="offset_bottom" type="float">540</property>
        <property name="horizontal_alignment" type="int">1</property>
        <property name="text" type="String"></property>
      </node>
    </node>
  </node>
</resource_file>
